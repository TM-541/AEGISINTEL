# AEGISINTEL configuration. Copy to .env and adjust. .env is git-ignored.
# .env is configuration, not encryption: protect this machine and file accordingly.
# No secrets are required for local use (session tokens are random per login).

THREATLENS_ENV=development              # development | test | production
THREATLENS_DATA_DIR=data
THREATLENS_LOG_LEVEL=INFO

# Sessions
THREATLENS_SESSION_IDLE_MINUTES=30
THREATLENS_SESSION_ABSOLUTE_HOURS=8

# Login throttling
THREATLENS_LOGIN_MAX_FAILURES=5
THREATLENS_LOGIN_LOCKOUT_MINUTES=15

# Ingestion limits
THREATLENS_MAX_UPLOAD_MB=10
THREATLENS_MAX_RECORDS=50000
THREATLENS_MAX_IMPORT_SECONDS=60

# Ollama (local). Non-loopback hosts are rejected unless ALLOW_REMOTE_OLLAMA=true.
# Measured on a CPU-only machine (see TESTING.md): llama3.2:3b produced a validated report in
# ~275 s; qwen3:8b exceeded a 600 s timeout. With a GPU, qwen3:8b is the better analyst.
THREATLENS_OLLAMA_HOST=http://127.0.0.1:11434
THREATLENS_OLLAMA_MODEL=llama3.2:3b
THREATLENS_OLLAMA_EMBED_MODEL=nomic-embed-text
THREATLENS_OLLAMA_TIMEOUT_SECONDS=600
THREATLENS_ALLOW_REMOTE_OLLAMA=false

# AI context bounds (smaller = faster on CPU)
THREATLENS_AI_MAX_EVENTS=15
THREATLENS_AI_MAX_FIELD_CHARS=300
THREATLENS_AI_REQUESTS_PER_USER_PER_HOUR=30

# Vector search (optional; requires the [vector] extra and the embedding model)
THREATLENS_ENABLE_VECTOR_SEARCH=true

# Response workflow: the proposer cannot approve their own proposal (separation of duties).
# Set to false only for single-user lab demos.
THREATLENS_RESPONSE_REQUIRE_TWO_PERSON=true
